# Host-only configuration; never place cloud credentials in Done Hub options.
AUDIT_ARCHIVE_DIR=/home/donehub/data/logs/audit/archive
# Required: configure this named remote with `rclone config` first.
AUDIT_BACKUP_DEST=mydrive:donehub-audit/production
RCLONE_CONFIG=/etc/donehub/rclone.conf
# For a mounted filesystem instead, set an absolute AUDIT_BACKUP_DEST and the
# actual mount point here. The job refuses to fall back to an unmounted root disk.
# AUDIT_BACKUP_MOUNT=/mnt/backup
